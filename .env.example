# Set the same non-empty value on both devices when using a shared network.
EDGE_STREAM_TOKEN=replace-with-a-long-random-value

# Device A settings used by scripts/device-control.sh.
EDGE_SERVER_URL=ws://192.168.1.10:8000
EDGE_DEVICE_ID=rpi5
EDGE_SOURCE=0
EDGE_CAMERA_CODEC=YUYV
EDGE_CAPTURE_WIDTH=960
EDGE_CAPTURE_HEIGHT=544
EDGE_MAX_WIDTH=960
EDGE_FPS=5
EDGE_JPEG_QUALITY=75
